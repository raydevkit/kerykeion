{
  "name": "kerykeion-kabalah",
  "version": "1.0.0",
  "description": "Kerykeion Astrology Microservice for Kabalah SaaS",
  "scripts": {
    "dev": "py -m poetry run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "start": "py -m poetry run uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "start:prod": "py -m poetry run uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 4",
    "test": "py -m poetry run pytest",
    "format": "py -m poetry run black app tests --line-length 120",
    "lint": "py -m poetry run mypy app"
  },
  "keywords": ["astrology", "api", "microservice", "kerykeion"],
  "author": "Kabalah Team",
  "license": "AGPL-3.0"
}
